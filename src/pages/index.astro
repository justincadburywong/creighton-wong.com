---
import BaseLayout from '../layouts/BaseLayout.astro';

const nav = [
  { href: '/index.html', label: 'Home', active: true },
  { href: '/index.html#fh5co-groom-bride', label: 'Groom & Bride' },
  { href: '/index.html#fh5co-when-where', label: 'When & Where' },
  { href: '/gallery.html', label: 'Gallery' },
  { href: '/index.html#fh5co-started', label: 'Registry' },
];
---

<BaseLayout
  title="Justin and Lynda Creighton-Wong's Wedding!"
  description="Justin and Lynda Creighton-Wong's wedding website"
  heroImage="/images/gallery/104-bp-180818.jpg"
  heroKicker="The Wedding"
  heroTitle="Lynda & Justin"
  heroMeta="08.18.2018"
  nav={nav}
  footerTitle="Lynda & Justin"
  footerText="A simple wedding site for a very good day."
>
  <section class="section section--soft" id="fh5co-couple">
    <div class="section-heading">
      <h2>Are Pleased To Announce Their Marriage</h2>
      <p><strong>on August 18, 2018 &mdash; San Rafael, California</strong></p>
    </div>

    <div class="couple">
      <div class="portrait-grid">
        <article class="portrait">
          <img src="/images/Lynda.jpeg" alt="Lynda" />
          <h3>Lynda Creighton</h3>
        </article>
        <article class="portrait">
          <img src="/images/Justin.jpeg" alt="Justin" />
          <h3>Justin Wong</h3>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="fh5co-groom-bride">
    <div class="section-heading">
      <h2>Bride &amp; Groom</h2>
    </div>

    <div class="couple-grid couple">
      <article class="couple-card">
        <div class="couple-card__media">
          <img src="/images/Lynda.jpeg" alt="Lynda Creighton" />
        </div>
        <div class="couple-card__body">
          <h3>Lynda Creighton</h3>
          <p>Born in Rhode Island, Lynda found her way to sunny California, and found it to be the place she wanted to spend the rest of her life. Little did she know this is where she would meet her life partner in Justin.</p>
        </div>
      </article>

      <article class="couple-card">
        <div class="couple-card__media">
          <img src="/images/Justin.jpeg" alt="Justin Wong" />
        </div>
        <div class="couple-card__body">
          <h3>Justin Wong</h3>
          <p>Justin was born in beautiful San Francisco and has been yearning for somebody to share this amazing place with. It was soon enough that he found a life partner in Lynda.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--soft" id="fh5co-when-where">
    <div class="section-heading">
      <h2>When &amp; Where</h2>
    </div>

    <div class="events">
      <div class="event-grid">
        <article class="event-card">
          <div class="event-card__image">
            <img src="/images/wed-ceremony.jpg" alt="Wedding ceremony" />
          </div>
          <div class="event-card__body">
            <h3>Wedding Ceremony &amp; Reception</h3>
            <p><strong>Saturday, August 18, 2018, 5.00 PM - 7.30PM @ 251 C Street</strong></p>
            <p>Invited guests, please join us for the ceremony and celebration of the couple in the backyard of their new home! Ties and high heels optional.</p>
          </div>
        </article>

        <article class="event-card">
          <div class="event-card__image">
            <img src="/images/wed-party.jpg" alt="Wedding dinner" />
          </div>
          <div class="event-card__body">
            <h3>Wedding Dinner</h3>
            <p><strong>Saturday, August 18, 2018, 8.30 PM - 11.00PM @ MadCap San Anselmo</strong></p>
            <p>Please allow the immediate family to enjoy a celebratory dinner later in the evening.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="registry" id="fh5co-started">
    <div class="registry__inner">
      <h2>Registry</h2>
      <p>Please find our registry at honeyfund.com. Thanks!</p>
      <a href="https://www.honeyfund.com/wedding/CreightonWong2018">CreightonWong2018</a>
    </div>
  </section>
</BaseLayout>
