---
import BaseLayout from '../layouts/BaseLayout.astro';

const nav = [
  { href: '/index.html', label: 'Home' },
  { href: '/groom-bride.html', label: 'Groom & Bride' },
  { href: '/when-where.html', label: 'When & Where', active: true },
  { href: '/gallery.html', label: 'Gallery' },
  { href: '/index.html#fh5co-started', label: 'Registry' },
];
---

<BaseLayout
  title="When &amp; Where | Creighton-Wong"
  description="When and where page for the Creighton-Wong wedding site"
  heroImage="/images/cover_bg_1.jpg"
  heroKicker="Nuptial"
  heroTitle="When & Where"
  nav={nav}
  footerTitle="Lynda & Justin"
  footerText="A simple wedding site for a very good day."
>
  <section class="section section--soft" id="fh5co-when-where">
    <div class="section-heading">
      <h2>When &amp; Where</h2>
    </div>

    <div class="events">
      <div class="event-grid">
        <article class="event-card">
          <div class="event-card__image">
            <img src="/images/wed-ceremony.jpg" alt="Wedding ceremony" />
          </div>
          <div class="event-card__body">
            <h3>Wedding Ceremony</h3>
            <p><strong>Saturday, December 28, 2017, 4.00 PM - 5.00PM @ Boracay Beach</strong></p>
            <p>Far far away, behind the word mountains, far from the countries Vokalia and Consonantia, there live the blind texts. Separated they live in Bookmarksgrove right at the coast of the Semantics, a large language ocean.</p>
          </div>
        </article>

        <article class="event-card">
          <div class="event-card__image">
            <img src="/images/wed-party.jpg" alt="Wedding party" />
          </div>
          <div class="event-card__body">
            <h3>Wedding Party</h3>
            <p><strong>Saturday, December 28, 2017, 6.00 PM - 11.00PM @ Boracay Beach</strong></p>
            <p>Far far away, behind the word mountains, far from the countries Vokalia and Consonantia, there live the blind texts. Separated they live in Bookmarksgrove right at the coast of the Semantics, a large language ocean.</p>
          </div>
        </article>
      </div>

      <div class="section-heading" style="margin-top: 3rem;">
        <p>Map details were part of the original template, but the page now keeps the same content without the old Google Maps dependency.</p>
      </div>
    </div>
  </section>
</BaseLayout>
