<BaseLayout
  title="Creighton-Wong's Wedding Gallery!"
  description="Wedding gallery for Justin and Lynda"
  heroImage="/images/gallery/133-mp-180818.jpg"
  heroKicker="The Wedding Gallery"
  heroTitle="Lynda & Justin"
  nav={nav}
  footerTitle="Lynda & Justin"
  footerText="A simple wedding site for a very good day."
>
  <section class="gallery-wrap" id="fh5co-gallery">
    <div class="section-heading">
      <h2>The Wedding Gallery</h2>
    </div>

    <div class="gallery-columns">
      {columns.map((column) => (
        <div class="gallery-stack">
          {column.map((file) => (
            <a class="gallery-card" href={`/images/gallery/${file}`}>
              <img loading="lazy" decoding="async" src={`/images/gallery/${file}`} alt="" />
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
