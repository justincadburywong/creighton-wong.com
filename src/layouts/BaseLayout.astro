---
import '../styles/site.css';

type NavItem = {
  href: string;
  label: string;
  active?: boolean;
};

type Props = {
  title: string;
  description?: string;
  heroImage: string;
  heroKicker: string;
  heroTitle: string;
  heroSubtitle?: string;
  heroMeta?: string;
  nav: NavItem[];
  footerTitle: string;
  footerText: string;
};

const {
  title,
  description = 'Lynda and Justin wedding website',
  heroImage,
  heroKicker,
  heroTitle,
  heroSubtitle,
  heroMeta,
  nav,
  footerTitle,
  footerText,
} = Astro.props as Props;
const heroWebp = heroImage.replace(/\.(jpe?g|png)$/i, '.webp');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f59cb0" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montez&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="site-logo" href="/index.html">Lynda &amp; Justin</a>
          <nav class="site-nav" aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li class={item.active ? 'is-active' : undefined}>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </header>

      <main>
        <section class="hero" style={`--hero-image: image-set(url(${heroWebp}) type('image/webp'), url(${heroImage}) type('image/jpeg'))`}>
          <div class="hero__overlay"></div>
          <div class="hero__content">
            <p class="hero__kicker">{heroKicker}</p>
            <h1>{heroTitle}</h1>
            {heroSubtitle && <p class="hero__subtitle">{heroSubtitle}</p>}
            {heroMeta && <p class="hero__meta">{heroMeta}</p>}
          </div>
        </section>

        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer__inner">
          <h2>{footerTitle}</h2>
          <p>{footerText}</p>
        </div>
      </footer>
    </div>
  </body>
  </html>
